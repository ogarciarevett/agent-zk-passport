{
  "name": "agent-zk-passport",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Verifiable identity passport + hardware-backed secret vault for personal AI agents. The passport (zk proof) gates capability issuance; capabilities gate every secret use; secrets never leave the broker.",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "sync:ai": "bun scripts/sync-ai-docs.ts",
    "sync:ai:all-inline": "bun scripts/sync-ai-docs.ts --all-inline",
    "check:sync": "bun scripts/sync-ai-docs.ts && git diff --exit-code",
    "prepare": "git config core.hooksPath .githooks || true",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "bun test",
    "demo": "bun apps/demo/src/index.ts",
    "broker": "bun apps/demo/src/broker-server.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.1.14",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "zod": "^3.24.1",
    "pino": "^9.5.0"
  },
  "engines": { "node": "^24.22.1" }
}
